        <service android:name="at.magixfly.coretracker.A11y" android:label="@string/a11y_name" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/a11y"/>
        </service>
    </application>
</manifest>
