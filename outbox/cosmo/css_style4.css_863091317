html {
	background-color:#111111;
	padding:0;
	margin:0;
	width:100%;
	height:100%;
	overflow:hidden;
	-webkit-user-select: none;
	-moz-user-select:-moz-none;
	-ms-user-select:none;
	user-select:none;
	font-family:Arial;
	position: fixed;
}

body {
	background-color:#111111;
	/*background-image:url(/imgs/background3.jpg);*/
	background-repeat:no-repeat;
	background-size:cover;
	background-position:50% 50%;
	padding:0;
	margin:0;
	width:100%;
	height:100%;
	overflow:hidden;
	-webkit-user-select: none;
	-moz-user-select:-moz-none;
	-ms-user-select:none;
	user-select:none;
	color:white;
	position: fixed;
}

input {
	border:2px double gray;
	cursor:pointer;
}

img {
	border-image:none;
}

a {
	color:white;
	text-decoration:none;
}

select, option {
	padding:3px;
}

::-webkit-scrollbar {
	width:0px;
	background:transparent;
}

::-webkit-scrollbar-thumb {
	background:#000000;
}

#video_container {
	background-color:black;
	width:100%;
	height:100%;
	display:none;
	cursor:move;
	position:absolute;
	margin:0;
}

#video_canvas {
	background-color:black;
	width:100%;
	height:100%;
	margin:0;
	display:none;
}

#video_element {
	background-color:black;
	width:100%;
	height:100%;
	margin:0;
	display:none;
}

#remotevideov1 {
	background-color:black;
	width:100%;
	height:100%;
	margin:0;
	display:none;
}

#remotevideov2 {
	background-color:black;
	width:320;
	height:200;
	margin:0;
	position:absolute;
	top:1px;
	left:1px;
	z-index:100;
	display:none;
	cursor:move;
}

#top_panel {
	position:absolute;
	top:0px;
	width:100%;
	height:auto;
	padding:5px;
	margin-right:-10px;
	background-color:#111111;
	color:white;
	display:none;
	font-size:0.7em;
	z-index:0;
	margin:0;
}

#top_area {
	display:block;
	background-color:black;
	font-size:10px;
	padding:5px;
	position:relative;
	margin:0;
}

#bottom_area {
	display:block;
	background-color:black;
	font-size:10px;
	padding:5px;
	position:relative;	
}

#bottom_big_container {
	background-color:transparent;
	width:100%;
	position:inherit;
	bottom:0px;
	display:none;
	text-align:center;
}

#left_area {
	cursor:default;
	text-align:center;
	background-color:transparent;
	opacity:1;
	position:inherit;
	top:60px;
	left:20px;
	height:auto;
	width:50px;
	overflow:scroll;
}

#right_area {
	cursor:default;
	background-color:black;
	position:inherit;
	top:20px;
	right:0px;
	height:100%; /*auto;*/
	width:auto;
	display:none;
	padding:10;
	overflow:scroll;
}

#restream_area {
	position:inherit;
	top:40px;
	left:100px;
	background-color:transparent;
	display:inline;
	font-size:10px;
}

.restream_btn {
	background-color:red;
	padding:5px;
	display:none;
	cursor:hand;
}

#tracking_area {
	position:absolute;
	top:0px;
	left:0px;
	background-color:blue;
	width:100px;
	height:100px;
	opacity:0.3;
	display:none;
}

#focus_area {
	position:absolute;
	top:0px;
	left:0px;
	background:transparent;
	border:2px double lightgreen;
	width:20px;
	height:20px;
	opacity:1;
	display:none;
	text-align:center;
}

#mode_block {
	opacity:1;
	cursor:default;
	background-color:black;
	padding:2px;
	border-radius:6px;
	margin-bottom:10px;
	display:none;
}

#zoom_block {
	opacity:1;
	cursor:default;
	background-color:black;
	padding:2px;
	border-radius:6px;
	margin-bottom:10px;
	margin-top:10px;
	display:none;
}

#dzoom_in_button {
	cursor:hand;
	margin-left:10px;
	margin-top:5px;
	width:25px;
	height:25px;
	background-image:url(/imgs/zoom_in.png);
}
#dzoom_out_button {
	cursor:hand;
	margin-left:10px;
	margin-top:10px;
	margin-bottom:10px;
	width:25px;
	height:25px;
	background-image:url(/imgs/zoom_out.png);
}
#zoom_in_button {
	cursor:hand;
	margin-left:10px;
	margin-top:20px;
	width:25px;
	height:25px;
	background-image:url(/imgs/zoom_in.png);
}
#zoom_out_button {
	cursor:hand;
	margin-left:10px;
	margin-top:10px;
	margin-bottom:10px;
	width:25px;
	height:25px;
	background-image:url(/imgs/zoom_out.png);
}


#hellomessage {
	position:absolute;
	top:0px;
	left:0px;
	right:0px;
	width:auto;
	height:auto;
	margin:0;
	padding:5px;
	text-align:center;
	color:white;
	background-color:#111111;
	display:none;
}

#cameradisconnectedmessage {
	display:none;
	position: fixed;
	top: 50%;
	left: 50%;
	-webkit-transform: translate(-50%, -50%);
	transform: translate(-50%, -50%);
	/*z-index:20;*/
	background-color:black;
	padding:10px;
	border-radius:10px;
	display:none;
}

#qr_block {
	display:none;
	position: fixed;
	top: 50%;
	left: 50%;
	-webkit-transform: translate(-50%, -50%);
	transform: translate(-50%, -50%);
	z-index:100;
}

#boardsupported_block, #bottom_red_block {
	position:absolute;
	bottom:0px;
	left:0px;
	right:0px;
	background-color:red;
	color:white;
	font-size:1.4em;
	padding:10px;
	display:none;
	z-index:10;
}

#license_block {
	position:absolute;
	bottom:0px;
	left:0px;
	right:0px;
	background-color:red;
	color:white;
	font-size:1.4em;
	padding:10px;
	display:none;
	z-index:10;
}

#connectionmessage {
	position:absolute;
	bottom:0px;
	left:0px;
	right:0px;
	padding:10px;
	display:none;
}

#menu_icons_area {
	position:absolute;
	bottom:10px;
	right:10px;
	opacity:1.0;
	cursor:hand;
	z-index:110;
}

#menu_icon {
	/*position:absolute;
	bottom:30px;
	right:30px;*/
	opacity:0.8;
	cursor:hand;
	z-index:110;
}

#close_icon {
	/*position:absolute;
	bottom:30px;
	right:30px;*/
	opacity:0.8;
	cursor:hand;
	z-index:120;
	display:none;
}

#menu_main {
	position:absolute;
	bottom:80px;
	right:30px;
	opacity:1;
	cursor:hand;
	background-color:black;
	padding:10px;
	border-radius:10px;
	display:none;
	z-index:110;
}

.main_menu_item {
	color:gray;
}
.main_menu_item:hover {
	color:white;
}

.green { color:lightgreen; }
.yellow { color:yellow; }
.gray { color:gray; }
.red { color:red; }

.hidden { display:none; }


#rec_start_image,#rec_stop_image,#photo_shot_image,#photo_stop_image,#photo_busy_image {
	display:none;
	cursor:hand;
}

#mode_photo_image,#mode_video_image {
	cursor:hand;
}

#rec_area,#shot_area {
	position:absolute;
	top:40px;
	right:100px;
	opacity:1;
	cursor:hand;
	background-color:black;
	padding:10px;
	border-radius:6px;
	width:auto;
	display:none;
}

#rec_circle {
	background:red;
	border-radius:50%;
	width:20px;
	height:20px;
	float:left;
	margin-right:5px;
	display:none;
}

#shot_circle {
	background:white;
	border-radius:50%;
	width:20px;
	height:20px;
	float:left;
	margin-right:5px;
}

.option_title {
	margin-top:0px;
	margin-bottom:5px;
	padding:0;
	/*font-size:12px;*/
}

.option_el {
	width:100%;
	font-size:12px;
	margin-bottom:10px;
	cursor:hand;
}

#camera_settings,#camera_controls {
	display:none;
}

#devicesettings_area {
	position:absolute;
	top:0;
	left:0;
	background-color:#111111;
	width:100%;
	height:100%;
	display:none;
	z-index:100;
}

.device_menu_item {
	padding:10px;
	font-size:14px;
}
.device_menu_item.active {
	background-color:#333333;
}
.device_menu_item.current {
	background-color:#333333;
}


.tab {
	overflow: hidden;
	border: 1px solid #ccc;
	background-color: #f1f1f1;
}

.tab button {
	background-color: inherit;
	float: left;
	border: none;
	outline: none;
	cursor: pointer;
	padding: 14px 16px;
	transition: 0.3s;
}

.tab button:hover {
	background-color: #ddd;
}

.tab button.active {
	background-color: #ccc;
}

.tabcontent, .tabcontent2 {
	display: none;
	padding: 6px 12px;
	border: 1px solid #ccc;
	border-top: none;
}


#mediaplayer_area {
	position:absolute;
	left:0px;
	top:0px;
	display:none;
	padding:6px 12px;
	background-color:#111111;
	width:162px;
	height:100%;
}

#gamepad_settings_container {
	position:absolute;
	left:0px;
	top:0px;
	display:none;
	padding:6px 12px;
	background-color:#111111;
	width:220px;
	height:100%;
}

.servo_slider {
	width:50px;
	appearance:slider-vertical;
	-moz-appearance:slider-vertical;
	-webkit-appearance:slider-vertical;
}
